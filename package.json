{
  "name": "stall10",
  "private": true,
  "description": "Stall 10 monorepo: apps/mobile (Flutter), apps/api (Node.js), apps/web (Next.js), packages/*, firebase/. See ARCHITECTURE.md.",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter=!@stall10/web build",
    "test": "pnpm -r --filter=!@stall10/web test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @stall10/shared build && pnpm --filter @stall10/api dev",
    "test:api:emulator": "pnpm --filter @stall10/api test:emulator"
  }
}
