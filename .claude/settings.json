{
  "agent": "orchestrator",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(./**/*.local.json)",
      "Edit(./**/*.local.json)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Read(./**/GoogleService-Info*.plist)",
      "Edit(./**/GoogleService-Info*.plist)",
      "Read(./**/google-services.json)",
      "Edit(./**/google-services.json)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/ios/Flutter/Secrets.xcconfig)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(firebase deploy * --project prod*)",
      "Bash(firebase deploy --project prod*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(firebase deploy *)",
      "Bash(gcloud run deploy *)",
      "Bash(gcloud run services replace *)",
      "Bash(gcloud builds submit *)",
      "Bash(vercel *)",
      "Bash(npm run deploy *)"
    ]
  }
}
