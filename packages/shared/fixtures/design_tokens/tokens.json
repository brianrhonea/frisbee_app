{
  "$comment": "Hylite design tokens (K1). The single list both platforms must match: apps/mobile/lib/ui/core/themes/theme.dart (AppColors, AppText, AppSpace, AppRadius, AppMotion) and apps/web/app/site.css (CSS variables). K8 tests read this file. Values change here first, with owner approval.",
  "version": 1,
  "color": {
    "canvas":      { "app": "background",     "web": "--bg",          "light": "#F4F4F5", "dark": "#09090B" },
    "canvas2":     { "app": null,             "web": "--bg-2",        "light": "#E4E4E7", "dark": "#18181B" },
    "surface":     { "app": "card",           "web": "--card",        "light": "#FFFFFF", "dark": "#18181B" },
    "raised":      { "app": "field",          "web": "--field",       "light": "#E4E4E7", "dark": "#27272A" },
    "border":      { "app": "border",         "web": "--line",        "light": "#D4D4D8", "dark": "#3F3F46" },
    "control":     { "app": "border2",        "web": "--line-2",      "light": "#71717A", "dark": "#71717A" },
    "text":        { "app": "ink",            "web": "--ink",         "light": "#18181B", "dark": "#FAFAFA" },
    "text2":       { "app": "ink2",           "web": "--ink-soft",    "light": "#3F3F46", "dark": "#D4D4D8" },
    "muted":       { "app": "muted",          "web": "--muted",       "light": "#52525B", "dark": "#A1A1AA" },
    "accent":      { "app": "accent",         "web": "--accent",      "light": "#4338CA", "dark": "#A5B4FC" },
    "onAccent":    { "app": "onAccent",       "web": "--on-accent",   "light": "#FFFFFF", "dark": "#18181B" },
    "accentSoft":  { "app": "accentSoft",     "web": "--accent-soft", "light": "#EEF2FF", "dark": "#1E1B4B" },
    "accentInk":   { "app": "accentInk",      "web": "--accent-ink",  "light": "#3730A3", "dark": "#C7D2FE" },
    "attention":   { "app": "highlight",      "web": "--disc",        "light": "#4338CA", "dark": "#A5B4FC" },
    "onAttention": { "app": "onHighlight",    "web": "--on-disc",     "light": "#FFFFFF", "dark": "#18181B" },
    "warningSoft": { "app": "highlightSoft",  "web": "--disc-soft",   "light": "#FEF3C7", "dark": "#451A03" },
    "warning":     { "app": "highlightInk",   "web": "--disc-ink",    "light": "#92400E", "dark": "#FCD34D" },
    "live":        { "app": "live",           "web": "--live",        "light": "#BE123C", "dark": "#FDA4AF" },
    "liveSoft":    { "app": "liveSoft",       "web": "--live-soft",   "light": "#FFE4E6", "dark": "#4C0519" },
    "liveInk":     { "app": "liveInk",        "web": "--live-ink",    "light": "#BE123C", "dark": "#FDA4AF" },
    "error":       { "app": "error",          "web": "--error",       "light": "#B91C1C", "dark": "#FCA5A5", "new": true },
    "errorSoft":   { "app": "errorSoft",      "web": "--error-soft",  "light": "#FEE2E2", "dark": "#450A0A", "new": true },
    "success":     { "app": "positive",       "web": "--success",     "light": "#166534", "dark": "#86EFAC", "new": "web" },
    "successSoft": { "app": "positiveSoft",   "web": "--success-soft","light": "#DCFCE7", "dark": "#052E16", "new": "web" },
    "nav":         { "app": "sidebar",        "web": null,            "light": "#FFFFFF", "dark": "#18181B" },
    "onNav":       { "app": "onSidebar",      "web": null,            "light": "#18181B", "dark": "#FAFAFA" },
    "onNavMuted":  { "app": "onSidebarMuted", "web": null,            "light": "#52525B", "dark": "#A1A1AA" },
    "feature":     { "app": "feature",        "web": "--board",       "light": "#FFFFFF", "dark": "#18181B", "retired": "dark card dropped (UI-Q6); now a light card" },
    "onFeature":   { "app": "onFeature",      "web": "--on-board",    "light": "#18181B", "dark": "#FAFAFA", "retired": true },
    "onFeatureMuted": { "app": "onFeatureMuted", "web": "--board-muted", "light": "#52525B", "dark": "#A1A1AA", "retired": true },
    "featureRaised":  { "app": "featureHighlight", "web": "--board-2",   "light": "#E4E4E7", "dark": "#27272A", "retired": true },
    "chipOn":      { "app": "chipOn",         "web": "--chip-on",     "light": "#4338CA", "dark": "#A5B4FC" },
    "onChipOn":    { "app": "onChipOn",       "web": "--on-chip-on",  "light": "#FFFFFF", "dark": "#18181B" },
    "team":        { "app": "team",           "web": "--team",        "light": "#1D4ED8", "dark": "#93C5FD" },
    "personal":    { "app": "personal",       "web": "--personal",    "light": "#A21CAF", "dark": "#F0ABFC" },
    "badge":       { "app": "badge",          "web": null,            "light": "#4338CA", "dark": "#4338CA" },
    "media":       { "app": "media",          "web": "--media",          "light": "#18181B", "dark": "#18181B", "new": true },
    "media2":      { "app": "media2",         "web": "--media-2",        "light": "#27272A", "dark": "#27272A", "new": true },
    "onMedia":     { "app": "onMedia",        "web": "--on-media",       "light": "#FAFAFA", "dark": "#FAFAFA", "new": true },
    "onMediaMuted":{ "app": "onMediaMuted",   "web": "--on-media-muted", "light": "#A1A1AA", "dark": "#A1A1AA", "new": true }
  },
  "webAliases": {
    "--amber": "--disc", "--on-amber": "--on-disc", "--brand": "--board", "--on-brand": "--on-board",
    "--glow": "--accent-soft", "--danger": "--error"
  },
  "contrast": [
    ["text", "surface", 4.5], ["text", "canvas", 4.5], ["text", "raised", 4.5],
    ["text2", "surface", 4.5], ["muted", "surface", 4.5], ["muted", "canvas", 4.5], ["muted", "raised", 4.5],
    ["accent", "surface", 4.5], ["accent", "canvas", 4.5], ["onAccent", "accent", 4.5],
    ["accentInk", "accentSoft", 4.5], ["onAttention", "attention", 4.5], ["onChipOn", "chipOn", 4.5],
    ["success", "surface", 4.5], ["success", "successSoft", 4.5],
    ["warning", "surface", 4.5], ["warning", "warningSoft", 4.5],
    ["error", "surface", 4.5], ["error", "errorSoft", 4.5],
    ["live", "surface", 4.5], ["liveInk", "liveSoft", 4.5],
    ["team", "surface", 3], ["personal", "surface", 3],
    ["control", "surface", 3], ["control", "raised", 3],
    ["onMedia", "media", 4.5], ["onMediaMuted", "media", 4.5], ["onMedia", "media2", 4.5], ["onMediaMuted", "media2", 4.5]
  ],
  "font": { "body": "Inter", "score": "Barlow Condensed" },
  "text": {
    "caption":   { "app": "AppText.caption",   "web": "--text-caption",   "size": 12, "line": 16, "weight": 500 },
    "secondary": { "app": "AppText.secondary", "web": "--text-secondary", "size": 14, "line": 20, "weight": 400 },
    "label":     { "app": "AppText.label",     "web": "--text-label",     "size": 14, "line": 20, "weight": 600 },
    "body":      { "app": "AppText.body",      "web": "--text-body",      "size": 16, "line": 24, "weight": 400 },
    "bodyStrong":{ "app": "AppText.bodyStrong","web": "--text-body-strong","size": 16, "line": 24, "weight": 600 },
    "section":   { "app": "AppText.section",   "web": "--text-section",   "size": 20, "line": 28, "weight": 700 },
    "heading3":  { "app": "AppText.heading3",  "web": "--text-heading3",  "size": 24, "line": 32, "weight": 700 },
    "heading2":  { "app": "AppText.heading2",  "web": "--text-heading2",  "size": 28, "line": 36, "weight": 800 },
    "heading1":  { "app": "AppText.heading1",  "web": "--text-heading1",  "size": 32, "line": 40, "weight": 800 },
    "scoreSmall":{ "app": "AppText.scoreSmall","web": "--text-score-small","size": 24, "line": 28, "weight": 800, "font": "score" },
    "score":     { "app": "AppText.score",     "web": "--text-score",     "size": 40, "line": 44, "weight": 800, "font": "score" }
  },
  "space": {
    "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48,
    "pageEdge": 16, "card": 16, "control": 12,
    "$names": { "app": "AppSpace.<name>", "web": "--space-<name>" }
  },
  "radius": {
    "card": 16, "control": 12, "pill": 999,
    "$names": { "app": "AppRadius.<name>", "web": { "card": "--radius", "control": "--radius-control", "pill": "--radius-pill" } }
  },
  "motion": {
    "fast": 120, "base": 200, "sheet": 300,
    "easing": [0.2, 0, 0, 1],
    "reducedMotion": 0,
    "$names": { "app": "AppMotion.<name>", "web": "--dur-<name>, --ease" }
  },
  "layout": {
    "minTarget": 48,
    "breakpoints": { "rail": 600, "sidebar": 900, "contextPanel": 1200, "maxContent": 1600 },
    "$note": "Breakpoints are listed for the shell work (S2/S3); K2-K8 do not change layout."
  }
}
