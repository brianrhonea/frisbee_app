rules_version = '2';

// Chat attachments and team post photos. Access follows the room's or
// post's access in Firestore (see firestore.rules); keep the two in step.
service firebase.storage {
  match /b/{bucket}/o {

    function team(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)).data;
    }
    function room(teamId, roomId) {
      return firestore.get(
        /databases/(default)/documents/teams/$(teamId)/chats/$(roomId)).data;
    }
    function role(t) {
      let r = t.members.get(request.auth.uid, '');
      return r == 'stats' ? 'player' : r;
    }
    function isMember(t) { return request.auth.uid in t.memberIds; }

    // Same as can() in firestore.rules: owners, coaches and captains have
    // every permission; others what their custom roles grant.
    function can(t, perm) {
      return role(t) in ['owner', 'coach', 'captain']
        || (isMember(t)
            && perm in t.get('memberPerms', {}).get(request.auth.uid, []));
    }

    // Same as inAudience() in firestore.rules: "everyone", the member's
    // tier, one of their (first 10) custom roles, or them by uid.
    function anyIn(mine, ids) {
      return (mine.size() > 0 && mine[0] in ids)
        || (mine.size() > 1 && mine[1] in ids)
        || (mine.size() > 2 && mine[2] in ids)
        || (mine.size() > 3 && mine[3] in ids)
        || (mine.size() > 4 && mine[4] in ids)
        || (mine.size() > 5 && mine[5] in ids)
        || (mine.size() > 6 && mine[6] in ids)
        || (mine.size() > 7 && mine[7] in ids)
        || (mine.size() > 8 && mine[8] in ids)
        || (mine.size() > 9 && mine[9] in ids);
    }
    function inAudience(t, ids, users) {
      return 'everyone' in ids
        || role(t) in ids
        || anyIn(t.get('memberRoles', {}).get(request.auth.uid, []), ids)
        || request.auth.uid in users;
    }
    function canRead(teamId, roomId) {
      let t = team(teamId);
      let r = room(teamId, roomId);
      return isMember(t)
        && (role(t) == 'owner' || inAudience(t, r.readRoles, r.readUsers));
    }
    function canWrite(teamId, roomId) {
      let t = team(teamId);
      let r = room(teamId, roomId);
      return isMember(t)
        && (role(t) == 'owner' || inAudience(t, r.writeRoles, r.writeUsers));
    }

    // Photos and files up to 10 MB (maxAttachmentBytes in
    // lib/domain/models/chat.dart), uploaded by their author into their
    // own folder. Authors delete their own; the owner, and moderators and
    // chat managers who can read the room, delete any.
    match /teams/{teamId}/chats/{roomId}/{userId}/{messageId}/{fileName} {
      allow get: if request.auth != null && canRead(teamId, roomId);
      // The desktop SDK uploads the bytes, then sets the content type as an
      // update, so authors may update their own files too.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && canWrite(teamId, roomId);
      allow delete: if request.auth != null
        && (request.auth.uid == userId
            || role(team(teamId)) == 'owner'
            || ((can(team(teamId), 'moderate')
                 || can(team(teamId), 'manageChats'))
                && canRead(teamId, roomId)));
    }

    // Team post photos, uploaded by members who can manage the team
    // before the post is saved. Visible like the post (see posts in firestore.rules):
    // to anyone signed in once it's public, otherwise to members.
    match /teams/{teamId}/posts/{postId}/{upload}/{fileName} {
      function postPath() {
        return /databases/(default)/documents/teams/$(teamId)/posts/$(postId);
      }

      allow get: if request.auth != null && (
        (firestore.exists(postPath())
          && firestore.get(postPath()).data.public == true)
        || isMember(team(teamId)));
      allow create, update: if request.auth != null
        && can(team(teamId), 'manageTeam')
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == null
            || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null && can(team(teamId), 'manageTeam');
    }

    // Uploaded team videos (TeamVideo.file in firestore.rules): video
    // files up to 500 MB, uploaded by members who can manage the team;
    // members watch. The desktop SDK sets the content type as a second write, so
    // it may be missing on create.
    match /teams/{teamId}/videos/{videoId}/{fileName} {

      allow get: if request.auth != null && isMember(team(teamId));
      allow create, update: if request.auth != null
        && can(team(teamId), 'manageTeam')
        && request.resource.size <= 500 * 1024 * 1024
        && (request.resource.contentType == null
            || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null && can(team(teamId), 'manageTeam');
    }

    // Photos on people's own posts (posts in firestore.rules), uploaded
    // into the author's folder before the post is saved. Posts are public
    // to anyone signed in, and so are their photos.
    match /users/{userId}/posts/{postId}/{upload}/{fileName} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == null
            || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Profile pictures and header photos (photoUrl and headerUrl in
    // profiles/{uid}), images up to 10 MB in the player's own folder.
    // Shown by download URL, to anyone signed in.
    match /users/{userId}/profile/{fileName} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && (request.resource.contentType == null
            || request.resource.contentType.matches('image/.*'));
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Direct-message attachments: conversation ids are "{uidA}_{uidB}", so
    // only those two can read, and each uploads into their own folder. A
    // group's ("g-…") are for its current members.
    match /conversations/{convId}/{userId}/{messageId}/{fileName} {
      function inConversation() {
        return request.auth != null
          && (convId.matches('g-[A-Za-z0-9]+')
              ? request.auth.uid in firestore.get(
                  /databases/(default)/documents/conversations/$(convId)).data.participants
              : request.auth.uid in convId.split('_'));
      }
      allow get: if inConversation();
      allow create, update: if inConversation()
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024;
      allow delete: if inConversation() && request.auth.uid == userId;
    }
  }
}
