# Copy to .env.local (gitignored) for local runs; on Vercel, set these in
# the project's Environment Variables. Never commit real values.

# The API, for server-side reads (apps/api; `pnpm dev:api` serves :8787).
API_BASE_URL=http://localhost:8787
# Shared secret with the API's WEB_SERVER_KEY, so the API doesn't rate-limit
# this server as one visitor (Vercel's firewall limits visitors instead).
WEB_SERVER_KEY=

# This site's public address, for links in shared previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web config, for signing in (Firebase console > Project settings >
# Your apps > Web app). Dev project locally and on Vercel previews; prod on
# production.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# The Storage bucket (e.g. <project>.firebasestorage.app), so members can
# load photos only signed-in readers may see.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# The API as the browser reaches it, for the member dashboard
# (GET /v1/me/home) and member writes. Usually the same as API_BASE_URL; the
# API's CORS_ORIGINS must list this site's address.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Optional: App Check for the browser (reCAPTCHA Enterprise site key). Needed
# once the API runs with ENFORCE_APP_CHECK.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Emulators: 127.0.0.1:9099 (Auth), 127.0.0.1:8080 (Firestore) and
# 127.0.0.1:9199 (Storage).
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
NEXT_PUBLIC_FIREBASE_STORAGE_EMULATOR_HOST=
