# Copy to .env.local (gitignored) for local runs; on Vercel, set these in
# the project's Environment Variables. Never commit real values.

# The API, for server-side reads (apps/api; `pnpm dev:api` serves :8787).
API_BASE_URL=http://localhost:8787
# Shared secret with the API's WEB_SERVER_KEY, so the API doesn't rate-limit
# this server as one visitor (Vercel's firewall limits visitors instead).
WEB_SERVER_KEY=

# This site's public address, for links in shared previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase web config, for signing in (Firebase console > Project settings >
# Your apps > Web app). Dev project locally and on Vercel previews; prod on
# production.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set to 127.0.0.1:9099 to sign in against the Auth emulator.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
