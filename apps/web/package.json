{
  "name": "@stall10/web",
  "version": "0.63.6",
  "private": true,
  "description": "Stall 10 website (phase 3): Next.js on Vercel; writes through apps/api, member reads from Firestore. Replaced the Flutter web build on Firebase Hosting.",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @stall10/shared build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@stall10/shared": "workspace:*",
    "@stripe/connect-js": "3.5.0",
    "@stripe/stripe-js": "10.2.1",
    "firebase": "^13.2.0",
    "livekit-client": "2.23.0",
    "next": "16.4.6",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
