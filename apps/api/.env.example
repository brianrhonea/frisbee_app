# Copy to .env (gitignored). No service-account keys: locally the API uses
# Application Default Credentials (`gcloud auth application-default login`)
# or the emulators; on Cloud Run it uses the service's own identity.
PORT=8787
# dev: frisbee-app-brianrhonea-dev, prod: frisbee-app-brianrhonea
FIREBASE_PROJECT_ID=frisbee-app-brianrhonea-dev
# Turn requests without a valid App Check token away (as ENFORCE_APP_CHECK
# does for the callables). Off until every build in use sends one.
ENFORCE_APP_CHECK=false
# Browser origins allowed to call the API (comma-separated; `*` matches one
# host label or port). Unset: http://localhost:3000 (apps/web's dev server).
# CORS_ORIGINS=http://localhost:3000
# Proxies in front of the API whose X-Forwarded-For to trust: 1 on Cloud
# Run, 0 locally.
TRUST_PROXY_HOPS=0
# Uncomment to use the emulators (cd firebase && firebase emulators:start).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# The project's Storage bucket, e.g. frisbee-app-brianrhonea-dev.firebasestorage.app.
# Public photo URLs use it (default <project>.firebasestorage.app); media
# uploads (/v1/uploads) are on only when it's set.
# STORAGE_BUCKET=
# ffmpeg for HEIC photos (and the transcode job); default: ffmpeg on PATH.
# FFMPEG_PATH=ffmpeg
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Cloud KMS key for personal details (/v1/me/personal; off when unset).
# Locally your gcloud account needs Encrypter/Decrypter on it (DEPLOY.md).
# PERSONAL_DETAILS_KMS_KEY=projects/frisbee-app-brianrhonea-dev/locations/us/keyRings/stall10/cryptoKeys/personal-details
# With the emulators only, a local key instead (32 bytes, base64:
# openssl rand -base64 32). Records it writes can't be read by Cloud Run.
# PERSONAL_DETAILS_LOCAL_KEY=
# Shared secret the website's server sends (x-stall10-web-key); set the same
# value as WEB_SERVER_KEY on Vercel. Generate one: openssl rand -hex 32
WEB_SERVER_KEY=
