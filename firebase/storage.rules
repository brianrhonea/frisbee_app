rules_version = '2';

// Chat attachments and team post photos. Access follows the room's or
// post's access in Firestore (see firestore.rules); keep the two in step.
service firebase.storage {
  match /b/{bucket}/o {

    // A complete account (see accountOk() in firestore.rules and
    // docs/specifications/contracts/account-gate.md): verified email, an
    // adult, Terms agreed. Every upload and delete needs it, except
    // profile pictures (onboarding). Downloads (get) don't.
    function accountOk() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.get('ageOk', false) == true
        && request.auth.token.get('terms', 0) is number
        && request.auth.token.get('terms', 0) >= 1;
    }

    function team(teamId) {
      return firestore.get(/databases/(default)/documents/teams/$(teamId)).data;
    }
    function room(teamId, roomId) {
      return firestore.get(
        /databases/(default)/documents/teams/$(teamId)/chats/$(roomId)).data;
    }
    function role(t) {
      let r = t.members.get(request.auth.uid, '');
      return r == 'stats' ? 'player' : r;
    }
    function isMember(t) { return request.auth.uid in t.memberIds; }

    // Pentest P3: only the types the app and site send, never SVG, HTML or
    // an untyped file (download URLs serve files inline on a Google domain).
    function photoType() {
      return request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|png|gif|webp|heic|heif|bmp)');
    }
    function videoType() {
      return request.resource.contentType != null
        && request.resource.contentType.matches('video/(mp4|quicktime|webm|3gpp)');
    }
    // Message attachments: photos, videos and the documents in
    // chatFileTypes (packages/shared media.ts, chat.dart's _contentTypes),
    // anything else as application/octet-stream (downloaded, not shown).
    function attachmentType() {
      return photoType() || videoType()
        || request.resource.contentType.matches(
          'application/(pdf|msword|vnd[.]ms-excel|vnd[.]ms-powerpoint|zip|octet-stream'
          + '|vnd[.]openxmlformats-officedocument[.](wordprocessingml[.]document|spreadsheetml[.]sheet|presentationml[.]presentation))'
          + '|text/(plain|csv)');
    }

    // Native video upload is off until the owner sets videoUploads true in
    // meta/flags (docs/specifications/contracts/meta-flags.md). A missing
    // document or field is closed. A file counts as a video by its content
    // type or by a video file name (as attachmentSizeOk does).
    function videoUploadsOn() {
      return firestore.exists(/databases/(default)/documents/meta/flags)
        && firestore.get(/databases/(default)/documents/meta/flags)
             .data.get('videoUploads', false) == true;
    }
    function videoAllowed(fileName) {
      return !(videoType() || fileName.lower().matches('.*[.](mp4|mov|m4v|webm|3gp)'))
        || videoUploadsOn();
    }

    // Message attachments: 10 MB, or 100 MB for videos (maxAttachmentBytes
    // and maxVideoBytes in lib/domain/models/chat.dart); videos are known
    // by name, and sent as a video type or octet-stream.
    function attachmentSizeOk(fileName) {
      return request.resource.size <= 10 * 1024 * 1024
        || (request.resource.size <= 100 * 1024 * 1024
            && fileName.lower().matches('.*[.](mp4|mov|m4v|webm|3gp)')
            && (request.resource.contentType == 'application/octet-stream'
                || videoType()));
    }

    // Same as can() in firestore.rules: owners, coaches and captains have
    // every permission; others what their custom roles grant.
    function can(t, perm) {
      return role(t) in ['owner', 'coach', 'captain']
        || (isMember(t)
            && perm in t.get('memberPerms', {}).get(request.auth.uid, []));
    }

    // Same as inAudience() in firestore.rules: "everyone", the member's
    // tier, one of their (first 10) custom roles, or them by uid.
    function anyIn(mine, ids) {
      return (mine.size() > 0 && mine[0] in ids)
        || (mine.size() > 1 && mine[1] in ids)
        || (mine.size() > 2 && mine[2] in ids)
        || (mine.size() > 3 && mine[3] in ids)
        || (mine.size() > 4 && mine[4] in ids)
        || (mine.size() > 5 && mine[5] in ids)
        || (mine.size() > 6 && mine[6] in ids)
        || (mine.size() > 7 && mine[7] in ids)
        || (mine.size() > 8 && mine[8] in ids)
        || (mine.size() > 9 && mine[9] in ids);
    }
    function inAudience(t, ids, users) {
      return 'everyone' in ids
        || role(t) in ids
        || anyIn(t.get('memberRoles', {}).get(request.auth.uid, []), ids)
        || request.auth.uid in users;
    }
    function canRead(teamId, roomId) {
      let t = team(teamId);
      let r = room(teamId, roomId);
      return isMember(t)
        && (role(t) == 'owner' || inAudience(t, r.readRoles, r.readUsers));
    }
    function canWrite(teamId, roomId) {
      let t = team(teamId);
      let r = room(teamId, roomId);
      return isMember(t)
        && (role(t) == 'owner' || inAudience(t, r.writeRoles, r.writeUsers));
    }

    // Photos and files up to 10 MB, videos up to 100 MB
    // (attachmentSizeOk), uploaded by their author into their
    // own folder. Authors delete their own; the owner, and moderators and
    // chat managers who can read the room, delete any.
    match /teams/{teamId}/chats/{roomId}/{userId}/{messageId}/{fileName} {
      allow get: if request.auth != null && canRead(teamId, roomId);
      allow create, update: if accountOk()
        && request.auth.uid == userId
        && attachmentSizeOk(fileName)
        && request.resource.contentType != null && attachmentType()
        && videoAllowed(fileName)
        && canWrite(teamId, roomId);
      allow delete: if accountOk()
        && (request.auth.uid == userId
            || role(team(teamId)) == 'owner'
            || ((can(team(teamId), 'moderate')
                 || can(team(teamId), 'manageChats'))
                && canRead(teamId, roomId)));
    }

    // Team post photos, uploaded by members who can manage the team
    // before the post is saved. Visible like the post (see posts in firestore.rules):
    // to anyone signed in once it's public, otherwise to members. Website
    // visitors without an account see a public post's photos too (the
    // `browse` functions list those posts), unless the team is a private
    // group.
    match /teams/{teamId}/posts/{postId}/{upload}/{fileName} {
      function postPath() {
        return /databases/(default)/documents/teams/$(teamId)/posts/$(postId);
      }
      function publicPost() {
        return firestore.exists(postPath())
          && firestore.get(postPath()).data.public == true;
      }
      // A private group, or a team whose "Public team page" is off
      // (publicPage false; showsPublic in firestore.rules).
      function privateGroup(t) {
        return (t.get('kind', 'team') in ['community', 'organization']
          && t.get('requiresApproval', false) == true)
          || t.get('publicPage', true) == false;
      }

      allow get: if (request.auth != null
          && (publicPost() || isMember(team(teamId))))
        || (publicPost() && !privateGroup(team(teamId)));
      allow create, update: if accountOk()
        && can(team(teamId), 'manageTeam')
        && request.resource.size <= 10 * 1024 * 1024
        && photoType();
      allow delete: if accountOk() && can(team(teamId), 'manageTeam');
    }

    // Uploaded team videos (TeamVideo.file in firestore.rules): video
    // files up to 500 MB, uploaded by members who can manage the team;
    // members watch.
    match /teams/{teamId}/videos/{videoId}/{fileName} {

      allow get: if request.auth != null && isMember(team(teamId));
      allow create, update: if accountOk()
        && can(team(teamId), 'manageTeam')
        && request.resource.size <= 500 * 1024 * 1024
        && videoType()
        && videoUploadsOn();
      allow delete: if accountOk() && can(team(teamId), 'manageTeam');
    }

    // Photos on people's own posts (posts in firestore.rules), uploaded
    // into the author's folder before the post is saved. Seen like the
    // post: by anyone, website visitors too, unless the author's profile
    // is private; then by the author and their accepted followers only.
    // (Checked on the profile, not the post: the photo is uploaded before
    // the post exists.)
    match /users/{userId}/posts/{postId}/{upload}/{fileName} {
      function publicAuthor() {
        let profile = /databases/(default)/documents/profiles/$(userId);
        return firestore.exists(profile)
          && firestore.get(profile).data.get('private', false) == false;
      }
      function privateAuthor() {
        let profile = /databases/(default)/documents/profiles/$(userId);
        return firestore.exists(profile)
          && firestore.get(profile).data.get('private', false) == true;
      }
      function ownerOrFollower() {
        return request.auth.uid == userId
          || firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/follows/$('user_' + userId));
      }

      // Signed in: any author without a private profile (as canSeePost
      // in firestore.rules), or a private one's own photos and followers.
      allow get: if publicAuthor()
        || (request.auth != null && (!privateAuthor() || ownerOrFollower()));
      allow create, update: if accountOk()
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && photoType();
      allow delete: if accountOk() && request.auth.uid == userId;
    }

    // Profile pictures and header photos (photoUrl and headerUrl in
    // profiles/{uid}), images up to 10 MB in the player's own folder.
    // Shown by download URL, to anyone signed in.
    match /users/{userId}/profile/{fileName} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && photoType();
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Direct-message attachments: conversation ids are "{uidA}_{uidB}", so
    // only those two can read, and each uploads into their own folder. A
    // group's ("g-…") are for its current members.
    match /conversations/{convId}/{userId}/{messageId}/{fileName} {
      function inConversation() {
        return request.auth != null
          && (convId.matches('g-[A-Za-z0-9]+')
              ? request.auth.uid in firestore.get(
                  /databases/(default)/documents/conversations/$(convId)).data.participants
              : request.auth.uid in convId.split('_'));
      }
      // Uploading also needs the conversation to exist, to list the
      // uploader, not be a message request still waiting on them, and (a
      // direct one) not be blocked either way. The same as creating a
      // message (conversations/{convId}/messages in firestore.rules). The
      // API writes users/{a}/blocks/{b} for both sides, so one lookup does.
      function convDoc() {
        return /databases/(default)/documents/conversations/$(convId);
      }
      function mayUpload() {
        let c = firestore.get(convDoc()).data;
        let ids = convId.split('_');
        let other = ids[0] == request.auth.uid ? ids[1] : ids[0];
        return firestore.exists(convDoc())
          && request.auth.uid in c.participants
          && !(c.get('status', 'accepted') == 'request'
               && c.get('requestedOf', null) == request.auth.uid)
          && (convId.matches('g-[A-Za-z0-9]+')
              || !firestore.exists(
                   /databases/(default)/documents/users/$(request.auth.uid)/blocks/$(other)));
      }
      allow get: if inConversation();
      allow create, update: if accountOk() && inConversation()
        && mayUpload()
        && request.auth.uid == userId
        && attachmentSizeOk(fileName)
        && request.resource.contentType != null && attachmentType()
        && videoAllowed(fileName);
      allow delete: if accountOk() && inConversation() && request.auth.uid == userId;
    }
  }
}
