rules_version = '2';

// Team membership is managed client-side, so these rules are the trust
// boundary: every membership change is validated here.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }
    function codePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }
    // The team's current invite code, readable by admins only.
    function invitePath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId)/private/invite;
    }
    // Code a user entered to join; the join() proof.
    function joinPath(teamId, userId) {
      return /databases/$(database)/documents/teams/$(teamId)/joins/$(userId);
    }
    // Older teams kept the code on the team doc until an admin opened them.
    function currentCode(teamId, team) {
      return exists(invitePath(teamId))
        ? get(invitePath(teamId)).data.code
        : team.get('inviteCode', '');
    }

    // Roles (TeamRole in lib/domain/models/team.dart):
    //   owner   everything: roles, ownership, new invite codes
    //   coach   team admin + stats
    //   captain team admin + stats
    //   player  read only; the owner can add stats access (statKeepers)
    // "stats" was briefly a role and still counts as a player with stats.
    function roleIn(team) { return team.members.get(uid(), ''); }
    function isOwner(team) { return roleIn(team) == 'owner'; }
    function isEditor(team) { return roleIn(team) in ['owner', 'coach', 'captain']; }
    function canKeepStats(team) {
      return isEditor(team)
        || roleIn(team) == 'stats'
        || (isMember(team) && uid() in team.get('statKeepers', []));
    }
    function isMember(team) { return uid() in team.memberIds; }

    // Chat rooms grant access by role; a legacy "stats" member is a player.
    function chatRole(team) {
      return roleIn(team) == 'stats' ? 'player' : roleIn(team);
    }
    function canReadRoom(team, room) {
      return roleIn(team) == 'owner'
        || chatRole(team) in room.readRoles
        || uid() in room.readUsers;
    }
    function canWriteRoom(team, room) {
      return roleIn(team) == 'owner'
        || chatRole(team) in room.writeRoles
        || uid() in room.writeUsers;
    }

    function validString(v, max) { return v is string && v.size() <= max; }

    function validTeamFields(t) {
      return t.name is string && t.name.size() > 0 && t.name.size() <= 80
        && t.division in ['mixed', 'open', 'women', 'masters']
        && t.level in ['club', 'college', 'youth', 'league', 'pickup']
        && validString(t.city, 80);
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Event details, shared by team and personal events.
    function validEvent(e) {
      return validEventDetails(e)
        && (e.poll == null || validPoll(e.poll))
        && e.get('public', false) is bool;
    }

    // What every event has, including public copies (no poll or responses).
    function validEventDetails(e) {
      return e.title is string && e.title.size() > 0 && e.title.size() <= 100
        && e.type in ['practice', 'game', 'tournament', 'scrimmage', 'workout', 'social', 'other']
        && e.startsAt is timestamp
        && (e.endsAt == null || (e.endsAt is timestamp && e.endsAt >= e.startsAt))
        && validString(e.location, 200)
        && validString(e.notes, 5000);
    }

    function validPoll(p) {
      return p.keys().hasOnly(['question', 'options', 'multiple'])
        && p.question is string && p.question.size() > 0 && p.question.size() <= 200
        && p.options is list && p.options.size() >= 2 && p.options.size() <= 10
        && p.multiple is bool;
    }

    // ---- Users ------------------------------------------------------------

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;

      // Personal schedule: private to its owner, no polls or responses.
      match /events/{eventId} {
        function validMine() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'title', 'type', 'startsAt', 'endsAt', 'location', 'notes',
                   'poll', 'createdAt', 'updatedAt'])
            && d.get('poll', null) == null
            && validEvent(d);
        }

        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId && validMine();
      }

      // Notification preferences (NotificationPreferences in
      // lib/domain/models/notification.dart). Cloud Functions read them.
      match /settings/notifications {
        function validPrefs() {
          let d = request.resource.data;
          let categories = ['chat', 'directMessages', 'eventChanges',
                            'eventReminders', 'teamActivity', 'meetings'];
          return d.keys().hasOnly(['categories', 'teams', 'mutedRooms',
                                   'utcOffsetMinutes', 'updatedAt'])
            && (!('categories' in d)
                || (d.categories is map
                    && d.categories.keys().hasOnly(categories)))
            && (!('teams' in d) || (d.teams is map && d.teams.size() <= 200))
            && (!('mutedRooms' in d)
                || (d.mutedRooms is list && d.mutedRooms.size() <= 500))
            && (!('utcOffsetMinutes' in d)
                || (d.utcOffsetMinutes is int
                    && d.utcOffsetMinutes >= -840 && d.utcOffsetMinutes <= 840));
        }

        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId && validPrefs();
      }

      // Push targets, keyed by Firebase Installation ID.
      match /devices/{fid} {
        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId
          && fid.size() <= 300
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
          && request.resource.data.platform in ['android', 'iOS', 'macOS'];
      }

      // The notification feed. Cloud Functions write it; the owner marks
      // entries read and clears them.
      match /notifications/{id} {
        allow read, delete: if signedIn() && uid() == userId;
        allow update: if signedIn() && uid() == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
      }
    }

    // ---- Teams ------------------------------------------------------------

    match /teams/{teamId} {
      allow read: if signedIn() && isMember(resource.data);

      // Creator becomes sole owner and must create the private invite code
      // and its lookup in the same batch. The code isn't on the team doc,
      // which every member can read.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'name', 'division', 'level', 'city', 'ownerId', 'members',
             'memberIds', 'memberNames', 'createdAt'])
        && validTeamFields(request.resource.data)
        && request.resource.data.ownerId == uid()
        && request.resource.data.members == {(uid()): 'owner'}
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.memberNames.keys().hasOnly([uid()])
        && getAfter(codePath(getAfter(invitePath(teamId)).data.code)).data.teamId == teamId;

      allow update: if signedIn() && (
        editDetails() || linkUsau() || dropLegacyCode() || changeRole() ||
        setStatKeepers() || transferOwnership() || removeMember() || join() ||
        markDeleting()
      );

      allow delete: if signedIn() && resource.data.ownerId == uid();

      function editDetails() {
        return isEditor(resource.data)
          && changed().hasOnly(['name', 'division', 'level', 'city'])
          && validTeamFields(request.resource.data);
      }

      // Owner stamps the team just before deleting it, so the notification
      // functions skip the cascade of deletes that follows; the stamp is
      // cleared again if the delete fails.
      function markDeleting() {
        return roleIn(resource.data) == 'owner'
          && changed().hasOnly(['deletingAt'])
          && request.resource.data.get('deletingAt', request.time) == request.time;
      }

            // Admins link the team's USA Ultimate page and stamp roster syncs.
      function linkUsau() {
        let t = request.resource.data;
        return isEditor(resource.data)
          && changed().hasOnly(['usauUrl', 'usauName', 'usauSyncedAt'])
          && (t.get('usauUrl', null) == null
              || (t.usauUrl is string && t.usauUrl.size() <= 300
                  && t.usauUrl.matches('https://play[.]usaultimate[.]org/teams/events/Eventteam/[?]TeamId=.+')))
          && (t.get('usauName', null) == null || validString(t.usauName, 120))
          && (t.get('usauSyncedAt', null) == null || t.usauSyncedAt == request.time);
      }

      // Admins move an older team's code off the team doc (into
      // private/invite) and clear the old join proof.
      function dropLegacyCode() {
        return isEditor(resource.data)
          && changed().hasOnly(['inviteCode', 'joinCode'])
          && request.resource.data.get('inviteCode', null) == null
          && request.resource.data.get('joinCode', null) == null;
      }

      // Owner changes another existing member's role. Rules can't pull the
      // one changed key out of a set, so check the result instead: every
      // role is valid, the owner is untouched and still the only owner.
      function changeRole() {
        let diff = request.resource.data.members.diff(resource.data.members);
        let roles = request.resource.data.members.values();
        return roleIn(resource.data) == 'owner'
          && changed().hasOnly(['members'])
          && diff.addedKeys().size() == 0
          && diff.removedKeys().size() == 0
          && diff.changedKeys().size() == 1
          && !(resource.data.ownerId in diff.changedKeys())
          && roles.hasOnly(['owner', 'coach', 'captain', 'stats', 'player'])
          && roles.removeAll(['coach', 'captain', 'stats', 'player']).size() == 1
          // No new "stats" roles; that's statKeepers now.
          && roles.removeAll(['stats']).size()
               >= resource.data.members.values().removeAll(['stats']).size();
      }

      // Owner gives members stats access or takes it away.
      function setStatKeepers() {
        let keepers = request.resource.data.statKeepers;
        return roleIn(resource.data) == 'owner'
          && changed().hasOnly(['statKeepers'])
          && keepers is list
          && keepers.size() <= 200
          && keepers.toSet().difference(resource.data.memberIds.toSet()).size() == 0;
      }

      // Owner hands the team to another member and becomes a player.
      function transferOwnership() {
        let next = request.resource.data.ownerId;
        let diff = request.resource.data.members.diff(resource.data.members);
        return roleIn(resource.data) == 'owner'
          && resource.data.ownerId == uid()
          && changed().hasOnly(['members', 'ownerId'])
          && next != uid()
          && next in resource.data.memberIds
          && diff.addedKeys().size() == 0
          && diff.removedKeys().size() == 0
          && diff.changedKeys() == [next, uid()].toSet()
          && request.resource.data.members[next] == 'owner'
          && request.resource.data.members[uid()] == 'player';
      }

      // Member leaves, owner removes anyone but themself, coaches and
      // captains remove players. Stats access goes with them.
      function removeMember() {
        let diff = request.resource.data.members.diff(resource.data.members);
        // Lists (unlike sets) can be indexed, so find who left via memberIds.
        let gone = resource.data.memberIds.removeAll(request.resource.data.memberIds);
        let target = gone[0];
        return changed().hasOnly(['members', 'memberIds', 'memberNames', 'statKeepers'])
          && gone.size() == 1
          && !(target in request.resource.data.get('statKeepers', []))
          && diff.removedKeys() == [target].toSet()
          && diff.addedKeys().size() == 0
          && diff.changedKeys().size() == 0
          && target != resource.data.ownerId
          && request.resource.data.memberIds.toSet()
               == resource.data.memberIds.toSet().difference([target].toSet())
          && !(target in request.resource.data.memberNames)
          && (target == uid()
              || roleIn(resource.data) == 'owner'
              || (roleIn(resource.data) in ['coach', 'captain']
                  && resource.data.members[target] in ['player', 'stats']));
      }

      // Non-member joins as a player by proving they know the invite code,
      // written to joins/{uid} in the same batch.
      function join() {
        let diff = request.resource.data.members.diff(resource.data.members);
        return !isMember(resource.data)
          && changed().hasOnly(['members', 'memberIds', 'memberNames'])
          && getAfter(joinPath(teamId, uid())).data.code == currentCode(teamId, resource.data)
          && diff.addedKeys() == [uid()].toSet()
          && diff.changedKeys().size() == 0
          && diff.removedKeys().size() == 0
          && request.resource.data.members[uid()] == 'player'
          && request.resource.data.memberIds.toSet()
               == resource.data.memberIds.toSet().union([uid()].toSet())
          && request.resource.data.memberNames.diff(resource.data.memberNames)
               .affectedKeys().hasOnly([uid()])
          && validString(request.resource.data.memberNames[uid()], 80);
      }

      // Current invite code. Owners, coaches and captains can read it; only
      // the owner can change it (coaches and captains may move an older
      // team's code here, keeping its existing lookup).
      match /private/{docId} {
        allow read: if signedIn() && docId == 'invite'
          && isEditor(get(teamPath(teamId)).data);
        allow create, update: if signedIn() && docId == 'invite'
          && request.resource.data.keys().hasOnly(['code'])
          && request.resource.data.code is string
          && isEditor(getAfter(teamPath(teamId)).data)
          && getAfter(codePath(request.resource.data.code)).data.teamId == teamId
          && (request.method == 'create' || isOwner(get(teamPath(teamId)).data));
        allow delete: if signedIn() && isOwner(get(teamPath(teamId)).data);
      }

      // Join proofs: each user writes only their own. The owner can list
      // them to delete the team.
      match /joins/{userId} {
        allow read: if signedIn()
          && (uid() == userId || isOwner(get(teamPath(teamId)).data));
        allow create, update: if signedIn() && uid() == userId
          && request.resource.data.keys().hasOnly(['code'])
          && validString(request.resource.data.code, 12);
        allow delete: if signedIn() && isOwner(get(teamPath(teamId)).data);
      }

      // What every member sees: name, number, position. Payment and USA
      // Ultimate status live in rosterStatus, readable by admins only.
      match /roster/{playerId} {
        allow read: if signedIn() && isMember(get(teamPath(teamId)).data);
        allow delete: if signedIn() && isEditor(get(teamPath(teamId)).data);
        allow create, update: if signedIn()
          && isEditor(get(teamPath(teamId)).data)
          && request.resource.data.keys().hasOnly(['name', 'number', 'position', 'userId'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && (request.resource.data.number == null || request.resource.data.number is int)
          && request.resource.data.position in ['handler', 'cutter', 'hybrid'];
      }

      // Per-player paid mark and USA Ultimate status, keyed like roster.
      // Owners, coaches and captains only; players can't read it.
      match /rosterStatus/{playerId} {
        allow read, delete: if signedIn() && isEditor(get(teamPath(teamId)).data);
        allow create, update: if signedIn()
          && isEditor(get(teamPath(teamId)).data)
          && request.resource.data.keys().hasOnly(['onUsau', 'paid'])
          && (request.resource.data.get('onUsau', null) == null || request.resource.data.onUsau is bool)
          && request.resource.data.get('paid', false) is bool;
      }

      match /plays/{playId} {
        allow read: if signedIn() && isMember(get(teamPath(teamId)).data);
        allow delete: if signedIn() && isEditor(get(teamPath(teamId)).data);
        allow create, update: if signedIn()
          && isEditor(get(teamPath(teamId)).data)
          && request.resource.data.keys().hasOnly([
               'name', 'category', 'notes', 'elements', 'arrows', 'steps',
               'updatedAt', 'updatedBy'])
          && validString(request.resource.data.name, 100)
          && request.resource.data.category in ['offense', 'defense', 'pull', 'endzone']
          && validString(request.resource.data.notes, 5000)
          && request.resource.data.elements is list
          && request.resource.data.elements.size() <= 100
          && request.resource.data.arrows is list
          && request.resource.data.arrows.size() <= 100
          && request.resource.data.get('steps', []) is list
          && request.resource.data.get('steps', []).size() <= 30
          && request.resource.data.updatedBy == uid();
      }

      // Editors manage events; every member may write only their own
      // RSVP, reactions and poll votes. Only members going may react or
      // vote, and leaving "going" must drop their reactions and votes.
      match /events/{eventId} {
        function team() { return get(teamPath(teamId)).data; }

        // Only `uid()`'s entry in map field `f` changed.
        function onlyMine(f) {
          return request.resource.data[f].diff(resource.data[f]).affectedKeys()
            .hasOnly([uid()]);
        }

        function respond() {
          let d = request.resource.data;
          return isMember(team())
            && changed().hasOnly(['rsvps', 'reactions', 'votes'])
            && onlyMine('rsvps') && onlyMine('reactions') && onlyMine('votes')
            && (d.rsvps.get(uid(), '') == 'going'
                || (!(uid() in d.reactions) && !(uid() in d.votes)))
            && (!(uid() in d.rsvps) || d.rsvps[uid()] in ['going', 'maybe', 'notGoing'])
            && (!(uid() in d.reactions)
                || (d.reactions[uid()] is list
                    && d.reactions[uid()].hasOnly(
                         ['thumbsUp', 'fire', 'disc', 'clap', 'laugh', 'grimace'])))
            && (!(uid() in d.votes)
                || (resource.data.poll != null
                    && d.votes[uid()] is list
                    && d.votes[uid()].size()
                         <= (resource.data.poll.multiple ? resource.data.poll.options.size() : 1)));
        }

        // Editors change details; they may only reset votes, never forge them.
        function editDetails() {
          return isEditor(team())
            && changed().hasOnly([
                 'title', 'type', 'startsAt', 'endsAt', 'location', 'notes',
                 'poll', 'public', 'votes', 'updatedAt'])
            && (!('votes' in changed()) || request.resource.data.votes == {})
            && validEvent(request.resource.data);
        }

        allow read: if signedIn() && isMember(team());
        allow delete: if signedIn() && isEditor(team());
        allow create: if signedIn()
          && isEditor(team())
          && request.resource.data.keys().hasOnly([
               'title', 'type', 'startsAt', 'endsAt', 'location', 'notes',
               'poll', 'public', 'rsvps', 'reactions', 'votes', 'createdBy',
               'createdAt', 'updatedAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.rsvps == {}
          && request.resource.data.reactions == {}
          && request.resource.data.votes == {}
          && validEvent(request.resource.data);
        allow update: if signedIn() && (respond() || editDetails());
      }

      // Copies of events marked public, for the team's public home page:
      // details only, so people outside the team never see responses.
      // Editors write them alongside the event.
      match /publicEvents/{eventId} {
        allow read: if signedIn();
        allow delete: if signedIn() && isEditor(get(teamPath(teamId)).data);
        allow create, update: if signedIn()
          && isEditor(get(teamPath(teamId)).data)
          && request.resource.data.keys().hasOnly([
               'title', 'type', 'startsAt', 'endsAt', 'location', 'notes',
               'updatedAt'])
          && validEventDetails(request.resource.data);
      }

      // Team meetings (TeamMeeting in lib/domain/models/meeting.dart).
      // Admins (owners, coaches, captains) see and manage every meeting;
      // other members see one only when their role is in inviteRoles or
      // their uid in inviteUsers. Admins start it (status 'live') and end
      // it; invitees only answer their own RSVP. The meetings-joinToken
      // Cloud Function makes the same checks before handing out a token
      // for the call; keep the two in step.
      match /meetings/{meetingId} {
        function team() { return get(teamPath(teamId)).data; }
        function meetingPath() {
          return /databases/$(database)/documents/teams/$(teamId)/meetings/$(meetingId);
        }
        function requestPath(userId) {
          return /databases/$(database)/documents/teams/$(teamId)/meetings/$(meetingId)/requests/$(userId);
        }

        function invited(m) {
          return isEditor(team())
            || chatRole(team()) in m.inviteRoles
            || uid() in m.inviteUsers;
        }

        // In the call, or allowed to be: admins, and invitees who were let
        // in when the meeting needs approval.
        function inCall(m) {
          return isEditor(team())
            || (invited(m)
                && (m.requireApproval != true
                    || (exists(requestPath(uid()))
                        && get(requestPath(uid())).data.status == 'admitted')));
        }

        function validMeeting(m) {
          let roles = ['owner', 'coach', 'captain', 'player'];
          return m.title is string && m.title.size() > 0 && m.title.size() <= 100
            && m.startsAt is timestamp
            && (m.endsAt == null || (m.endsAt is timestamp && m.endsAt >= m.startsAt))
            && validString(m.notes, 5000)
            && m.inviteRoles is list && m.inviteRoles.hasOnly(roles)
            && m.inviteUsers is list && m.inviteUsers.size() <= 200
            && m.requireApproval is bool;
        }

        function respond() {
          let d = request.resource.data;
          return invited(resource.data)
            && changed().hasOnly(['rsvps'])
            && d.rsvps.diff(resource.data.rsvps).affectedKeys().hasOnly([uid()])
            && (!(uid() in d.rsvps) || d.rsvps[uid()] in ['attending', 'notAttending']);
        }

        function editDetails() {
          return isEditor(team())
            && changed().hasOnly([
                 'title', 'startsAt', 'endsAt', 'notes', 'inviteRoles',
                 'inviteUsers', 'requireApproval', 'updatedAt'])
            && validMeeting(request.resource.data);
        }

        function start() {
          let d = request.resource.data;
          return isEditor(team())
            && resource.data.status == 'scheduled'
            && changed().hasOnly(['status', 'startedAt', 'startedBy'])
            && d.status == 'live'
            && d.startedAt == request.time
            && d.startedBy == uid();
        }

        function end() {
          let d = request.resource.data;
          return isEditor(team())
            && resource.data.status != 'ended'
            && changed().hasOnly(['status', 'endedAt'])
            && d.status == 'ended'
            && d.endedAt == request.time;
        }

        allow read: if signedIn() && isMember(team()) && invited(resource.data);
        allow create: if signedIn()
          && isEditor(team())
          && request.resource.data.keys().hasOnly([
               'title', 'startsAt', 'endsAt', 'notes', 'inviteRoles',
               'inviteUsers', 'requireApproval', 'status', 'rsvps',
               'createdBy', 'createdAt', 'updatedAt'])
          && request.resource.data.status == 'scheduled'
          && request.resource.data.rsvps == {}
          && request.resource.data.createdBy == uid()
          && validMeeting(request.resource.data);
        allow update: if signedIn() && isMember(team())
          && (respond() || editDetails() || start() || end());
        allow delete: if signedIn() && isEditor(team());

        // Asking to join a meeting that needs approval, keyed by uid.
        // Invitees ask (or ask again) for themselves; admins let them in
        // or turn them away.
        match /requests/{userId} {
          function meeting() { return get(meetingPath()).data; }

          allow read: if signedIn() && (uid() == userId || isEditor(team()));
          allow create, update: if signedIn() && uid() == userId
            && isMember(team())
            && invited(meeting())
            && meeting().requireApproval == true
            && meeting().status != 'ended'
            && request.resource.data.keys().hasOnly(['name', 'status', 'requestedAt'])
            && request.resource.data.status == 'pending'
            && validString(request.resource.data.name, 80)
            && request.resource.data.requestedAt == request.time;
          allow update: if signedIn() && isEditor(team())
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'decidedBy', 'decidedAt'])
            && request.resource.data.status in ['admitted', 'denied']
            && request.resource.data.decidedBy == uid()
            && request.resource.data.decidedAt == request.time;
          allow delete: if signedIn() && (uid() == userId || isEditor(team()));
        }

        // The chat inside the call: text only, for people in the call.
        // Authors delete their own; admins moderate and clear it when the
        // meeting is deleted.
        match /messages/{messageId} {
          function meeting() { return get(meetingPath()).data; }

          allow read: if signedIn() && isMember(team()) && inCall(meeting());
          allow create: if signedIn() && isMember(team())
            && meeting().status == 'live'
            && inCall(meeting())
            && request.resource.data.keys().hasOnly([
                 'authorId', 'authorName', 'text', 'createdAt'])
            && request.resource.data.authorId == uid()
            && validString(request.resource.data.authorName, 80)
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.createdAt == request.time;
          allow delete: if signedIn()
            && (resource.data.authorId == uid() || isEditor(team()));
        }
      }

      // Home page posts (TeamPost in lib/domain/models/team_post.dart).
      // Editors post; anyone signed in reads public posts, members the rest.
      match /posts/{postId} {
        function team() { return get(teamPath(teamId)).data; }

        // Text, a photo, or both; up to 5 web links and 4 photos
        // (TeamPost.maxLinks / maxImages). Photos are in Storage under
        // teams/{teamId}/posts/{postId}/ (see storage.rules).
        function validPost(p) {
          let links = p.get('links', []);
          let images = p.get('images', []);
          return validString(p.title, 100)
            && validString(p.body, 5000)
            && validString(p.get('location', ''), 200)
            && links is list && links.size() <= 5
            && (links.size() < 1 || validLink(links[0]))
            && (links.size() < 2 || validLink(links[1]))
            && (links.size() < 3 || validLink(links[2]))
            && (links.size() < 4 || validLink(links[3]))
            && (links.size() < 5 || validLink(links[4]))
            && images is list && images.size() <= 4
            && (p.body.size() > 0 || images.size() > 0)
            && p.public is bool;
        }

        function validLink(l) {
          return l is string && l.size() <= 500 && l.matches('https?://.+');
        }

        allow read: if signedIn()
          && (resource.data.public == true || isMember(team()));
        allow delete: if signedIn() && isEditor(team());
        allow create: if signedIn()
          && isEditor(team())
          && request.resource.data.keys().hasOnly([
               'title', 'body', 'location', 'links', 'images', 'public',
               'authorId', 'authorName', 'createdAt', 'updatedAt'])
          && request.resource.data.authorId == uid()
          && validString(request.resource.data.authorName, 80)
          && request.resource.data.createdAt == request.time
          && validPost(request.resource.data);
        allow update: if signedIn() && isEditor(team())
          && changed().hasOnly([
               'title', 'body', 'location', 'links', 'images', 'public',
               'updatedAt'])
          && validPost(request.resource.data);
      }

      // Chat rooms (ChatRoom in lib/domain/models/chat.dart). Each room
      // lists the roles and members who can read and who can write; write
      // lists are subsets of read lists. The owner can read and post in
      // every room. Owners, coaches and captains create rooms and set their
      // access, so they can see every room's details; only the owner, who
      // can read every message, deletes rooms. storage.rules guards
      // attachments with the same checks.
      match /chats/{roomId} {
        function team() { return get(teamPath(teamId)).data; }

        function validRoom(r) {
          let roles = ['owner', 'coach', 'captain', 'player'];
          return r.name is string && r.name.size() > 0 && r.name.size() <= 60
            && r.readRoles is list && r.readRoles.hasOnly(roles)
            && r.writeRoles is list && r.writeRoles.hasOnly(roles)
            && r.readUsers is list && r.readUsers.size() <= 200
            && r.writeUsers is list && r.writeUsers.size() <= 200
            && r.writeRoles.toSet().difference(r.readRoles.toSet()).size() == 0
            && r.writeUsers.toSet().difference(r.readUsers.toSet()).size() == 0;
        }

        allow read: if signedIn() && isMember(team())
          && (isEditor(team()) || canReadRoom(team(), resource.data));
        // getAfter: General is created in the same batch as its team.
        allow create: if signedIn()
          && isEditor(getAfter(teamPath(teamId)).data)
          && request.resource.data.keys().hasOnly([
               'name', 'readRoles', 'writeRoles', 'readUsers', 'writeUsers',
               'createdBy', 'createdAt'])
          && validRoom(request.resource.data)
          && request.resource.data.createdBy == uid()
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn() && isEditor(team())
          && changed().hasOnly([
               'name', 'readRoles', 'writeRoles', 'readUsers', 'writeUsers'])
          && validRoom(request.resource.data);
        allow delete: if signedIn() && isOwner(team());

        match /messages/{messageId} {
          function room() {
            return get(/databases/$(database)/documents/teams/$(teamId)/chats/$(roomId)).data;
          }

          allow read: if signedIn() && isMember(team())
            && canReadRoom(team(), room());
          allow create: if signedIn() && isMember(team())
            && canWriteRoom(team(), room())
            && request.resource.data.keys().hasOnly([
                 'authorId', 'authorName', 'text', 'attachments', 'createdAt'])
            && request.resource.data.authorId == uid()
            && validString(request.resource.data.authorName, 80)
            && validString(request.resource.data.text, 4000)
            && request.resource.data.attachments is list
            && request.resource.data.attachments.size() <= 10
            && (request.resource.data.text.size() > 0
                || request.resource.data.attachments.size() > 0)
            && request.resource.data.createdAt == request.time;
          // Authors delete their own; the owner moderates.
          allow delete: if signedIn()
            && (resource.data.authorId == uid() || isOwner(team()));
        }
      }

      // Stats: owners, coaches, captains and players with stats access
      // keep them; every member can view.
      // A game holds its points, lines and timeouts in one document.
      function validLines(lines) {
        return lines is list && lines.size() <= 50;
      }

      match /statsTournaments/{tournamentId} {
        function team() { return get(teamPath(teamId)).data; }

        allow read: if signedIn() && isMember(team());
        allow delete: if signedIn() && canKeepStats(team());
        allow create, update: if signedIn()
          && canKeepStats(team())
          && request.resource.data.keys().hasOnly([
               'name', 'startDate', 'location', 'eventId', 'roster', 'lines',
               'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.startDate is timestamp
          && validString(request.resource.data.location, 200)
          && (request.resource.data.eventId == null
              || validString(request.resource.data.eventId, 100))
          && request.resource.data.roster is list
          && request.resource.data.roster.size() <= 200
          && validLines(request.resource.data.lines);
      }

      match /statsGames/{gameId} {
        function team() { return get(teamPath(teamId)).data; }

        allow read: if signedIn() && isMember(team());
        allow delete: if signedIn() && canKeepStats(team());
        allow create, update: if signedIn()
          && canKeepStats(team())
          && request.resource.data.keys().hasOnly([
               'opponent', 'date', 'gameTo', 'tournamentId', 'eventId',
               'points', 'finished', 'lines', 'timeoutsPerHalf', 'timeouts',
               'updatedAt'])
          && request.resource.data.opponent is string
          && request.resource.data.opponent.size() > 0
          && request.resource.data.opponent.size() <= 100
          && request.resource.data.date is timestamp
          && request.resource.data.gameTo is int
          && request.resource.data.gameTo > 0
          && request.resource.data.gameTo <= 50
          && (request.resource.data.tournamentId == null
              || validString(request.resource.data.tournamentId, 100))
          && (request.resource.data.eventId == null
              || validString(request.resource.data.eventId, 100))
          && request.resource.data.points is list
          && request.resource.data.points.size() <= 150
          && request.resource.data.finished is bool
          && validLines(request.resource.data.lines)
          && request.resource.data.timeoutsPerHalf is int
          && request.resource.data.timeoutsPerHalf >= 0
          && request.resource.data.timeoutsPerHalf <= 10
          && request.resource.data.timeouts is list
          && request.resource.data.timeouts.size() <= 40;
      }
    }

    // ---- Team directory ---------------------------------------------------

    // Public team listings for search (TeamListing in
    // lib/domain/models/team.dart): name, division, level and city only,
    // copied from the team. Editors write them with the team, so getAfter
    // covers the create and edit batches.
    match /teamDirectory/{teamId} {
      function validListing(d, team) {
        return d.keys().hasOnly(['name', 'division', 'level', 'city', 'keywords'])
          && d.name == team.name
          && d.division == team.division
          && d.level == team.level
          && d.city == team.get('city', '')
          && d.keywords is list && d.keywords.size() <= 100;
      }

      allow read: if signedIn();
      allow create, update: if signedIn()
        && isEditor(getAfter(teamPath(teamId)).data)
        && validListing(request.resource.data, getAfter(teamPath(teamId)).data);
      // The owner deletes it with the team; a listing left without a team
      // is anyone's to clear.
      allow delete: if signedIn()
        && (!exists(teamPath(teamId)) || isOwner(get(teamPath(teamId)).data));
    }

    // ---- Direct messages --------------------------------------------------

    // The people directory: name and photo only (never email), so any
    // signed-in user can search for someone to message.
    match /profiles/{userId} {
      allow read: if signedIn();
      allow delete: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['name', 'keywords', 'photoUrl', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.keywords is list
        && request.resource.data.keywords.size() <= 100
        && (request.resource.data.photoUrl == null
            || validString(request.resource.data.photoUrl, 2000));
    }

    // One conversation per pair of users, id "{uidA}_{uidB}" with the uids
    // sorted. Only the two participants can read it or post. The id names
    // them, so a participant can check whether it exists before creating it.
    match /conversations/{convId} {
      function inConversation() { return uid() in convId.split('_'); }
      function convPath() {
        return /databases/$(database)/documents/conversations/$(convId);
      }
      // Only their own read time and name may change, besides the preview.
      function onlyMine(f) {
        return request.resource.data[f].diff(resource.data[f]).affectedKeys()
          .hasOnly([uid()]);
      }

      allow get: if signedIn() && inConversation();
      allow list: if signedIn() && uid() in resource.data.participants;
      allow create: if signedIn() && inConversation()
        && request.resource.data.keys().hasOnly([
             'participants', 'names', 'lastMessage', 'lastMessageAt',
             'lastSenderId', 'readAt', 'createdAt'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && convId == request.resource.data.participants[0] + '_'
             + request.resource.data.participants[1]
        // The other person must be a listed user.
        && exists(/databases/$(database)/documents/profiles/$(
             request.resource.data.participants[0] == uid()
               ? request.resource.data.participants[1]
               : request.resource.data.participants[0]))
        && request.resource.data.names.keys().toSet()
             == request.resource.data.participants.toSet()
        && validString(request.resource.data.names[request.resource.data.participants[0]], 80)
        && validString(request.resource.data.names[request.resource.data.participants[1]], 80)
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastMessageAt == null
        && request.resource.data.lastSenderId == ''
        && request.resource.data.readAt == {}
        && request.resource.data.createdAt == request.time;
      // Posting updates the preview; opening marks it read.
      allow update: if signedIn() && inConversation() && (
        (changed().hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'readAt', 'names'])
          && request.resource.data.lastSenderId == uid()
          && request.resource.data.lastMessageAt == request.time
          && validString(request.resource.data.lastMessage, 200)
          && onlyMine('readAt') && onlyMine('names')
          && validString(request.resource.data.names[uid()], 80))
        || (changed().hasOnly(['readAt'])
          && onlyMine('readAt')
          && request.resource.data.readAt[uid()] == request.time)
      );

      match /messages/{messageId} {
        allow read: if signedIn() && inConversation();
        allow create: if signedIn() && inConversation()
          && exists(convPath())
          && request.resource.data.keys().hasOnly([
               'authorId', 'authorName', 'text', 'attachments', 'createdAt'])
          && request.resource.data.authorId == uid()
          && validString(request.resource.data.authorName, 80)
          && validString(request.resource.data.text, 4000)
          && request.resource.data.attachments is list
          && request.resource.data.attachments.size() <= 10
          && (request.resource.data.text.size() > 0
              || request.resource.data.attachments.size() > 0)
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && resource.data.authorId == uid();
      }
    }

    // ---- Invite codes -----------------------------------------------------

    match /inviteCodes/{code} {
      // Single-document lookups only; codes can't be listed.
      allow get: if signedIn();
      // Only the owner mints codes, alongside the team's private/invite.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['teamId'])
        && getAfter(invitePath(request.resource.data.teamId)).data.code == code
        && getAfter(teamPath(request.resource.data.teamId)).data.members
             .get(uid(), '') == 'owner';
      allow delete: if signedIn() && isOwner(get(teamPath(resource.data.teamId)).data);
    }

    // ---- USA Ultimate cache (written by Cloud Functions only) -------------

    match /usau_tournaments/{id} {
      allow read: if signedIn();
    }
    match /usau_rankings/{id} {
      allow read: if signedIn();
    }
    match /meta/{id} {
      allow read: if signedIn();
    }
  }
}
