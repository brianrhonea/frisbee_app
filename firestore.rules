rules_version = '2';

// Team membership is managed client-side, so these rules are the trust
// boundary: every membership change is validated here.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }
    function codePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    // Roles (TeamRole in lib/domain/models/team.dart):
    //   owner   everything: roles, ownership, new invite codes
    //   coach   team admin + stats
    //   captain team admin + stats
    //   player  read only; the owner can add stats access (statKeepers)
    // "stats" was briefly a role and still counts as a player with stats.
    function roleIn(team) { return team.members.get(uid(), ''); }
    function isOwner(team) { return roleIn(team) == 'owner'; }
    function isEditor(team) { return roleIn(team) in ['owner', 'coach', 'captain']; }
    function canKeepStats(team) {
      return isEditor(team)
        || roleIn(team) == 'stats'
        || (isMember(team) && uid() in team.get('statKeepers', []));
    }
    function isMember(team) { return uid() in team.memberIds; }

    function validString(v, max) { return v is string && v.size() <= max; }

    function validTeamFields(t) {
      return t.name is string && t.name.size() > 0 && t.name.size() <= 80
        && t.division in ['mixed', 'open', 'women', 'masters']
        && t.level in ['club', 'college', 'youth', 'league', 'pickup']
        && validString(t.city, 80);
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Event details, shared by team and personal events.
    function validEvent(e) {
      return e.title is string && e.title.size() > 0 && e.title.size() <= 100
        && e.type in ['practice', 'game', 'tournament', 'scrimmage', 'workout', 'social', 'other']
        && e.startsAt is timestamp
        && (e.endsAt == null || (e.endsAt is timestamp && e.endsAt >= e.startsAt))
        && validString(e.location, 200)
        && validString(e.notes, 5000)
        && (e.poll == null || validPoll(e.poll));
    }

    function validPoll(p) {
      return p.keys().hasOnly(['question', 'options', 'multiple'])
        && p.question is string && p.question.size() > 0 && p.question.size() <= 200
        && p.options is list && p.options.size() >= 2 && p.options.size() <= 10
        && p.multiple is bool;
    }

    // ---- Users ------------------------------------------------------------

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;

      // Personal schedule: private to its owner, no polls or responses.
      match /events/{eventId} {
        function validMine() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'title', 'type', 'startsAt', 'endsAt', 'location', 'notes',
                   'poll', 'createdAt', 'updatedAt'])
            && d.get('poll', null) == null
            && validEvent(d);
        }

        allow read, delete: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId && validMine();
      }
    }

    // ---- Teams ------------------------------------------------------------

    match /teams/{teamId} {
      allow read: if signedIn() && isMember(resource.data);

      // Creator becomes sole owner and must create the matching invite code
      // in the same batch.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'name', 'division', 'level', 'city', 'ownerId', 'members',
             'memberIds', 'memberNames', 'inviteCode', 'createdAt'])
        && validTeamFields(request.resource.data)
        && request.resource.data.ownerId == uid()
        && request.resource.data.members == {(uid()): 'owner'}
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.memberNames.keys().hasOnly([uid()])
        && request.resource.data.inviteCode is string
        && getAfter(codePath(request.resource.data.inviteCode)).data.teamId == teamId;

      allow update: if signedIn() && (
        editDetails() || linkUsau() || regenerateCode() || changeRole() ||
        setStatKeepers() || transferOwnership() || removeMember() || join()
      );

      allow delete: if signedIn() && resource.data.ownerId == uid();

      function editDetails() {
        return isEditor(resource.data)
          && changed().hasOnly(['name', 'division', 'level', 'city'])
          && validTeamFields(request.resource.data);
      }

      // Admins link the team's USA Ultimate page and stamp roster syncs.
      function linkUsau() {
        let t = request.resource.data;
        return isEditor(resource.data)
          && changed().hasOnly(['usauUrl', 'usauName', 'usauSyncedAt'])
          && (t.get('usauUrl', null) == null
              || (t.usauUrl is string && t.usauUrl.size() <= 300
                  && t.usauUrl.matches('https://play[.]usaultimate[.]org/teams/events/Eventteam/[?]TeamId=.+')))
          && (t.get('usauName', null) == null || validString(t.usauName, 120))
          && (t.get('usauSyncedAt', null) == null || t.usauSyncedAt == request.time);
      }

      function regenerateCode() {
        return isOwner(resource.data)
          && changed().hasOnly(['inviteCode'])
          && getAfter(codePath(request.resource.data.inviteCode)).data.teamId == teamId;
      }

      // Owner changes another existing member's role. Rules can't pull the
      // one changed key out of a set, so check the result instead: every
      // role is valid, the owner is untouched and still the only owner.
      function changeRole() {
        let diff = request.resource.data.members.diff(resource.data.members);
        let roles = request.resource.data.members.values();
        return roleIn(resource.data) == 'owner'
          && changed().hasOnly(['members'])
          && diff.addedKeys().size() == 0
          && diff.removedKeys().size() == 0
          && diff.changedKeys().size() == 1
          && !(resource.data.ownerId in diff.changedKeys())
          && roles.hasOnly(['owner', 'coach', 'captain', 'stats', 'player'])
          && roles.removeAll(['coach', 'captain', 'stats', 'player']).size() == 1
          // No new "stats" roles; that's statKeepers now.
          && roles.removeAll(['stats']).size()
               >= resource.data.members.values().removeAll(['stats']).size();
      }

      // Owner gives members stats access or takes it away.
      function setStatKeepers() {
        let keepers = request.resource.data.statKeepers;
        return roleIn(resource.data) == 'owner'
          && changed().hasOnly(['statKeepers'])
          && keepers is list
          && keepers.size() <= 200
          && keepers.toSet().difference(resource.data.memberIds.toSet()).size() == 0;
      }

      // Owner hands the team to another member and becomes a player.
      function transferOwnership() {
        let next = request.resource.data.ownerId;
        let diff = request.resource.data.members.diff(resource.data.members);
        return roleIn(resource.data) == 'owner'
          && resource.data.ownerId == uid()
          && changed().hasOnly(['members', 'ownerId'])
          && next != uid()
          && next in resource.data.memberIds
          && diff.addedKeys().size() == 0
          && diff.removedKeys().size() == 0
          && diff.changedKeys() == [next, uid()].toSet()
          && request.resource.data.members[next] == 'owner'
          && request.resource.data.members[uid()] == 'player';
      }

      // Member leaves, owner removes anyone but themself, coaches and
      // captains remove players. Stats access goes with them.
      function removeMember() {
        let diff = request.resource.data.members.diff(resource.data.members);
        // Lists (unlike sets) can be indexed, so find who left via memberIds.
        let gone = resource.data.memberIds.removeAll(request.resource.data.memberIds);
        let target = gone[0];
        return changed().hasOnly(['members', 'memberIds', 'memberNames', 'statKeepers'])
          && gone.size() == 1
          && !(target in request.resource.data.get('statKeepers', []))
          && diff.removedKeys() == [target].toSet()
          && diff.addedKeys().size() == 0
          && diff.changedKeys().size() == 0
          && target != resource.data.ownerId
          && request.resource.data.memberIds.toSet()
               == resource.data.memberIds.toSet().difference([target].toSet())
          && !(target in request.resource.data.memberNames)
          && (target == uid()
              || roleIn(resource.data) == 'owner'
              || (roleIn(resource.data) in ['coach', 'captain']
                  && resource.data.members[target] in ['player', 'stats']));
      }

      // Non-member joins as a player by proving they know the invite code.
      function join() {
        let diff = request.resource.data.members.diff(resource.data.members);
        return !isMember(resource.data)
          && changed().hasOnly(['members', 'memberIds', 'memberNames', 'joinCode'])
          && request.resource.data.joinCode == resource.data.inviteCode
          && diff.addedKeys() == [uid()].toSet()
          && diff.changedKeys().size() == 0
          && diff.removedKeys().size() == 0
          && request.resource.data.members[uid()] == 'player'
          && request.resource.data.memberIds.toSet()
               == resource.data.memberIds.toSet().union([uid()].toSet())
          && request.resource.data.memberNames.diff(resource.data.memberNames)
               .affectedKeys().hasOnly([uid()])
          && validString(request.resource.data.memberNames[uid()], 80);
      }

      match /roster/{playerId} {
        allow read: if signedIn() && isMember(get(teamPath(teamId)).data);
        allow delete: if signedIn() && isEditor(get(teamPath(teamId)).data);
        allow create, update: if signedIn()
          && isEditor(get(teamPath(teamId)).data)
          && request.resource.data.keys().hasOnly(['name', 'number', 'position', 'userId', 'onUsau', 'paid'])
          && (request.resource.data.get('onUsau', null) == null || request.resource.data.onUsau is bool)
          && (request.resource.data.get('paid', false) is bool)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && (request.resource.data.number == null || request.resource.data.number is int)
          && request.resource.data.position in ['handler', 'cutter', 'hybrid'];
      }

      match /plays/{playId} {
        allow read: if signedIn() && isMember(get(teamPath(teamId)).data);
        allow delete: if signedIn() && isEditor(get(teamPath(teamId)).data);
        allow create, update: if signedIn()
          && isEditor(get(teamPath(teamId)).data)
          && request.resource.data.keys().hasOnly([
               'name', 'category', 'notes', 'elements', 'arrows', 'steps',
               'updatedAt', 'updatedBy'])
          && validString(request.resource.data.name, 100)
          && request.resource.data.category in ['offense', 'defense', 'pull', 'endzone']
          && validString(request.resource.data.notes, 5000)
          && request.resource.data.elements is list
          && request.resource.data.elements.size() <= 100
          && request.resource.data.arrows is list
          && request.resource.data.arrows.size() <= 100
          && request.resource.data.get('steps', []) is list
          && request.resource.data.get('steps', []).size() <= 30
          && request.resource.data.updatedBy == uid();
      }

      // Editors manage events; every member may write only their own
      // RSVP, reactions and poll votes. Only members going may react or
      // vote, and leaving "going" must drop their reactions and votes.
      match /events/{eventId} {
        function team() { return get(teamPath(teamId)).data; }

        // Only `uid()`'s entry in map field `f` changed.
        function onlyMine(f) {
          return request.resource.data[f].diff(resource.data[f]).affectedKeys()
            .hasOnly([uid()]);
        }

        function respond() {
          let d = request.resource.data;
          return isMember(team())
            && changed().hasOnly(['rsvps', 'reactions', 'votes'])
            && onlyMine('rsvps') && onlyMine('reactions') && onlyMine('votes')
            && (d.rsvps.get(uid(), '') == 'going'
                || (!(uid() in d.reactions) && !(uid() in d.votes)))
            && (!(uid() in d.rsvps) || d.rsvps[uid()] in ['going', 'maybe', 'notGoing'])
            && (!(uid() in d.reactions)
                || (d.reactions[uid()] is list
                    && d.reactions[uid()].hasOnly(
                         ['thumbsUp', 'fire', 'disc', 'clap', 'laugh', 'grimace'])))
            && (!(uid() in d.votes)
                || (resource.data.poll != null
                    && d.votes[uid()] is list
                    && d.votes[uid()].size()
                         <= (resource.data.poll.multiple ? resource.data.poll.options.size() : 1)));
        }

        // Editors change details; they may only reset votes, never forge them.
        function editDetails() {
          return isEditor(team())
            && changed().hasOnly([
                 'title', 'type', 'startsAt', 'endsAt', 'location', 'notes',
                 'poll', 'votes', 'updatedAt'])
            && (!('votes' in changed()) || request.resource.data.votes == {})
            && validEvent(request.resource.data);
        }

        allow read: if signedIn() && isMember(team());
        allow delete: if signedIn() && isEditor(team());
        allow create: if signedIn()
          && isEditor(team())
          && request.resource.data.keys().hasOnly([
               'title', 'type', 'startsAt', 'endsAt', 'location', 'notes',
               'poll', 'rsvps', 'reactions', 'votes', 'createdBy',
               'createdAt', 'updatedAt'])
          && request.resource.data.createdBy == uid()
          && request.resource.data.rsvps == {}
          && request.resource.data.reactions == {}
          && request.resource.data.votes == {}
          && validEvent(request.resource.data);
        allow update: if signedIn() && (respond() || editDetails());
      }

      // Stats: owners, coaches, captains and players with stats access
      // keep them; every member can view.
      // A game holds its points, lines and timeouts in one document.
      function validLines(lines) {
        return lines is list && lines.size() <= 50;
      }

      match /statsTournaments/{tournamentId} {
        function team() { return get(teamPath(teamId)).data; }

        allow read: if signedIn() && isMember(team());
        allow delete: if signedIn() && canKeepStats(team());
        allow create, update: if signedIn()
          && canKeepStats(team())
          && request.resource.data.keys().hasOnly([
               'name', 'startDate', 'location', 'eventId', 'roster', 'lines',
               'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 100
          && request.resource.data.startDate is timestamp
          && validString(request.resource.data.location, 200)
          && (request.resource.data.eventId == null
              || validString(request.resource.data.eventId, 100))
          && request.resource.data.roster is list
          && request.resource.data.roster.size() <= 200
          && validLines(request.resource.data.lines);
      }

      match /statsGames/{gameId} {
        function team() { return get(teamPath(teamId)).data; }

        allow read: if signedIn() && isMember(team());
        allow delete: if signedIn() && canKeepStats(team());
        allow create, update: if signedIn()
          && canKeepStats(team())
          && request.resource.data.keys().hasOnly([
               'opponent', 'date', 'gameTo', 'tournamentId', 'eventId',
               'points', 'finished', 'lines', 'timeoutsPerHalf', 'timeouts',
               'updatedAt'])
          && request.resource.data.opponent is string
          && request.resource.data.opponent.size() > 0
          && request.resource.data.opponent.size() <= 100
          && request.resource.data.date is timestamp
          && request.resource.data.gameTo is int
          && request.resource.data.gameTo > 0
          && request.resource.data.gameTo <= 50
          && (request.resource.data.tournamentId == null
              || validString(request.resource.data.tournamentId, 100))
          && (request.resource.data.eventId == null
              || validString(request.resource.data.eventId, 100))
          && request.resource.data.points is list
          && request.resource.data.points.size() <= 150
          && request.resource.data.finished is bool
          && validLines(request.resource.data.lines)
          && request.resource.data.timeoutsPerHalf is int
          && request.resource.data.timeoutsPerHalf >= 0
          && request.resource.data.timeoutsPerHalf <= 10
          && request.resource.data.timeouts is list
          && request.resource.data.timeouts.size() <= 40;
      }
    }

    // ---- Invite codes -----------------------------------------------------

    match /inviteCodes/{code} {
      // Single-document lookups only; codes can't be listed.
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['teamId'])
        && getAfter(teamPath(request.resource.data.teamId)).data.inviteCode == code
        && getAfter(teamPath(request.resource.data.teamId)).data.members
             .get(uid(), '') == 'owner';
      allow delete: if signedIn() && isOwner(get(teamPath(resource.data.teamId)).data);
    }

    // ---- USA Ultimate cache (written by Cloud Functions only) -------------

    match /usau_tournaments/{id} {
      allow read: if signedIn();
    }
    match /usau_rankings/{id} {
      allow read: if signedIn();
    }
    match /meta/{id} {
      allow read: if signedIn();
    }
  }
}
