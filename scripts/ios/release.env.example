# Copy to ~/.hylite-release.env on the Mac, fill in the values, then:
#   chmod 600 ~/.hylite-release.env
# Never commit the filled-in copy, paste it into a chat, or screenshot it.
# Plain KEY=value lines (no export needed). release-ios.sh and mac-doctor.sh
# print variable NAMES only, never values.

# --- Required -------------------------------------------------------------
# App Store Connect API key (role: App Manager). Key ID from the Keys page.
ASC_KEY_ID=
# Issuer ID, shown above the key list in App Store Connect.
ASC_ISSUER_ID=
# Path to AuthKey_<KEYID>.p8, mode 600. Keep it at the standard place so
# xcrun altool finds it: ~/.appstoreconnect/private_keys/AuthKey_<KEYID>.p8
ASC_KEY_PATH=
# Apple Developer Team ID (10 characters).
APPLE_TEAM_ID=

# --- Dev build (defaults in brackets) -------------------------------------
# Name of the App Store provisioning profile for the dev bundle ID
# [Stall 10 App Store].
PROFILE_NAME_DEV=
# Bundle ID [com.brianrhonea.frisbeeApp].
BUNDLE_ID_DEV=
# Numeric Apple ID of the app in App Store Connect [6830314904].
APP_STORE_APPLE_ID_DEV=

# --- Prod build: leave empty until #9 / R3 are done -----------------------
# release-ios.sh prod also refuses unless HYLITE_PROD_READY=1 is set.
PROFILE_NAME_PROD=
BUNDLE_ID_PROD=
APP_STORE_APPLE_ID_PROD=
